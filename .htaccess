# Delta State Election Results Portal
# Apache Configuration

DirectoryIndex index.php

# Protect database files and SQL dumps from direct web access
<FilesMatch "\.(sqlite|sql|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Default character set
AddDefaultCharset UTF-8
